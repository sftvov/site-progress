section.route.section(id=route.id)
  .container
    .n1o1.col2
      .col5
        h2.t1d !{route.title}
        p.p1 !{route.intro}
      .row.x3col.g3
        +mediaPicture(
          486,
          'img/contacts/',
          route.img,
          'png',
          'n1w5 n3w6 w4',
          '',
          false,
          {
            x4: { sizes: 12, width: 300 },
            x3: { sizes: 12, width: 508 },
            x2: { sizes: 6, width: 358 },
            x1: { sizes: 6, width: 466 }
          }
        )
        .col3.ais
          each block in route.blocks
            .col5
              h3.t2d.r10.aic
                svg.sd.sw2.i24
                  use(xlink:href='img/sprite/symbols.svg#' + block.icon)
                | !{block.title}
              div
                each p in block.text
                  p.p1 !{p}
          a.t2.fb-link.sb-link.link-b.r.aic(href="#")  
            | Скачать инструкцию            
            svg.i24
              use(xlink:href='img/sprite/symbols.svg#triangle-right')