.main-slider.section#slider
  .container.x3contents
    .main-slider__swiper.swiper
      .swiper-wrapper
        each slide in mainSlider
          +mainSlide(slide)
      .main-slider__navigation.row.aic.jcb.n1w6.n2w3.n3w4.w2.x4w4
        .main-slider__prev.sb-link.r.aic.jce.x1jcs.w1
          svg.deg90.i24
            use(xlink:href='img/sprite/symbols.svg#chevron-down')
        .main-slider__next.sb-link.r.x1jce.aic.w1
          svg.deg-90.i24
            use(xlink:href='img/sprite/symbols.svg#chevron-down')

