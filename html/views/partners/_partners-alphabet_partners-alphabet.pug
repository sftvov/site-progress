include ../../../data/partnersArchive

-
  firstLetters = partnersArchive
    .map(item => item.name.charAt(0).toUpperCase()) // Берем первую букву и делаем заглавной
    .filter((letter, index, array) => array.indexOf(letter) === index) // Убираем дубликаты
    .sort() // Сортируем по алфавиту

  partners = {
    items: partnersArchive,
  }

.section.partners#partners(data-filters)
  .container
    .col3
      h1.title Партнеры ЦНТИ&nbsp;ПРОГРЕСС
      .col7.tac.x1tas
        p.p1 ЦНТИ&nbsp;ПРОГРЕСС гордится многолетними партнерскими отношениями с ведущими научными и образовательными учреждениями, отраслевыми институтами, крупнейшими производственными предприятиями и организациями.
        p.p1 Мы благодарим наших Интернет-партнеров за плодотворную совместную работу.
      .partners__letters.g5.cg15
        each letter in firstLetters
          button.partners__letter.dur.p1.sqr.bd2l(data-filter=letter)= letter
      .partners__grid
        each item in partnersArchive
          +itemClient(item)(class='_active' data-item=item.name.charAt(0).toUpperCase())
      .partners__grid
        button.button-accent.partners__button(data-reset-all) Сбросить

