include ../../../data/clientsArchive

-
  clientsArchiveFiltered = clientsArchive.map(item => ({
    ...item,               
    desc: ''             
  }));

.section.partners#partners
  .container
    .col3(data-items data-start-items-md2=15 data-start-items=12 data-show-items=999)
      h1.title Постоянные клиенты на семинарах ЦНТИ&nbsp;ПРОГРЕСС
      .col7.tac.x1tas
        p.p1 Компании – лидеры современной экономики России и стран СНГ доверяют повышение квалификации своих сотрудников ЦНТИ&nbsp;ПРОГРЕСС.
        p.p1 За годы работы #[span.ta свыше 50 000 компаний] стали нашими постоянными партнерами по организации обучения своих сотрудников.
        p.p1 #[span.ta Более 20 000 специалистов] и руководителей #[span.ta ежегодно] проходят повышение квалификации в ЦНТИ&nbsp;ПРОГРЕСС.
      .partners__grid(data-items-container)
        each item in clientsArchiveFiltered
          +itemClient(item)(data-item='')
      .partners__grid
        button.button-accent.partners__button(data-items-btn) Показать еще
        button.button-accent.partners__button(data-items-hide) Свернуть


