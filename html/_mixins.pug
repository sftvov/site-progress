mixin pageConfig(config = {})
  -
    const defaultConfig = {
      title: '',
      description: 'Описание',
      styles: { external: [], internal: [] },
      scripts: { head: [], external: [], internal: [] },
      breadcrumbs: false,
    }
    page = { ...defaultConfig, ...config }

mixin picture(width, folder = 'img/promo/', baseName, extension = 'png', imgClass = '', alt = '', lazy = false, columns = [12,12,12,12])
  -
    const widths = {
      '0.6x': Math.ceil(width * 0.6),
      '1.2x': Math.ceil(width * 1.2),
      '1.8x': Math.ceil(width * 1.8),
      '2.4x': Math.ceil(width * 2.4)
    };

    function getColumnWidth(n, field) {
      if (typeof n === 'string') return n;
      if (n === 12) return `calc(100vw - ${field}px)`;
      if (n === 6) return `calc((100vw - ${field - 20}px)) / 2 - 20px`;
      if (n === 4) return `calc((100vw - ${field - 20}px)) / 3 - 20px`;
      if (n === 3) return `calc((100vw - ${field - 20}px)) / 4 - 20px`;
      if (n === 2) return `calc((100vw - ${field - 20}px)) / 6 - 20px`;
      return `calc((100vw - ${field - 20}px)) / 12 * ${n} - 20px`;
    }

    const breakpoints = [
      { max: 539.95, cols: columns[3], field: 20 },
      { max: 767.95, cols: columns[2], field: 32 },
      { max: 1031.95, cols: columns[1], field: 32 },
      { max: 1279.95, cols: columns[0], field: 80 }
    ].filter(bp => bp.cols !== undefined);

    const sizesList = breakpoints.map(bp => `(max-width: ${bp.max}px) ${getColumnWidth(bp.cols, bp.field)}`);
    sizesList.push(`${width}px`);

    const sizesAttr = sizesList.join(', ');
    const srcsetWebp = Object.entries(widths)
      .map(([scale, w]) => `${folder}${baseName}@${scale}.webp ${w}w`)
      .join(', ');

  picture&attributes(attributes)
    source(
      type='image/webp'
      sizes=sizesAttr
      srcset=srcsetWebp
    )
    img(
      src=`${folder}${baseName}.${extension}`
      alt=alt
      width=width
      height='auto'
      loading=lazy ? 'lazy' : false
      class=imgClass
    )


mixin mediaPicture(width, folder = 'img/hotels/', baseName, extension = 'png', imgClass = '', alt = '', lazy = false, sources = [{ max: 539.95, key: 'x4', sizes: 'calc(100vw - 20px)', width: 320, columns: undefined },{ max: 767.95, key: 'x3', sizes: 'calc(100vw - 32px)', width: 540, columns: undefined },{ max: 1031.95, key: 'x2', sizes: 'calc(100vw - 32px)', width: 768, columns: undefined },{ max: 1279.95, key: 'x1', sizes: 'calc(100vw - 80px)', width: 1032, columns: undefined }], defaultSizes = [])
  -
    // Функция для расчета ширины для разных плотностей
    function getWidths(baseWidth) {
      return {
        '0.6x': Math.ceil(baseWidth * 0.6),
        '1.2x': Math.ceil(baseWidth * 1.2),
        '1.8x': Math.ceil(baseWidth * 1.8),
        '2.4x': Math.ceil(baseWidth * 2.4)
      };
    }
    
    // Функция для расчета ширины по колонкам (из первого миксина)
    function getColumnWidth(n, field) {
      if (typeof n === 'string') return n;
      if (n === 12) return `calc(100vw - ${field}px)`;
      if (n === 6) return `calc((100vw - ${field - 20}px) / 2 - 20px)`;
      if (n === 4) return `calc((100vw - ${field - 20}px) / 3 - 20px)`;
      if (n === 3) return `calc((100vw - ${field - 20}px) / 4 - 20px)`;
      if (n === 2) return `calc((100vw - ${field - 20}px) / 6 - 20px)`;
      return `calc((100vw - ${field - 20}px) / 12 * ${n} - 20px)`;
    }
    
    // Функция для генерации srcset
    function getSrcset(baseName, folder, baseWidth, extension) {
      if (!baseName) return '';
      
      const widths = getWidths(baseWidth);
      
      // Для webp
      const webpSrcset = Object.entries(widths)
        .filter(([_, w]) => w > 0)
        .map(([scale, w]) => `${folder}${baseName}${baseName.includes('@') ? '' : '@'}${scale}.webp ${w}w`)
        .join(', ');
      
      // Для обычного формата
      const imgSrcset = `${folder}${baseName}.${extension}`;
      
      return { webpSrcset, imgSrcset };
    }    

    let defaultSizesAttr = `${width}px`;
    if (defaultSizes && defaultSizes.length > 0) {
      const sortedSizes = [...defaultSizes].sort((a, b) => (a.max || Infinity) - (b.max || Infinity));
      const fallback = sortedSizes.find(s => !s.max);
      const withMedia = sortedSizes.filter(s => s.max);
      const sizesParts = withMedia.map(s => `(max-width: ${s.max}px) ${s.sizes}`);
      if (fallback) {
        sizesParts.push(fallback.sizes);
      } else {
        sizesParts.push(`${width}px`);
      }
      defaultSizesAttr = sizesParts.join(', ');
    }

    // Фильтруем sources - убираем те, где key === false или key === null
    const activeSources = sources.filter(s => s.key !== false && s.key !== null);
    
    // Формируем baseName с ключом
    function getFullBaseName(baseName, key) {
      if (!key) return baseName;
      return `${key}${baseName}`;
    }
    
    // Обрабатываем sources - преобразуем sizes в колонки если нужно
    const processedSources = activeSources.map(source => {
      const processed = { ...source };
      
      // Если sizes не строка, считаем как колонки
      if (source.sizes !== undefined && typeof source.sizes !== 'string') {
        // Для sizes колонок используем field из source или дефолтный
        const field = source.field || 20;
        processed.sizes = getColumnWidth(source.sizes, field);
      }
      
      return processed;
    });
    
    // Аналогично обрабатываем defaultSizes
    let processedDefaultSizes = defaultSizes;
    if (defaultSizes && defaultSizes.length > 0) {
      processedDefaultSizes = defaultSizes.map(item => {
        const processed = { ...item };
        if (item.sizes !== undefined && typeof item.sizes !== 'string') {
          const field = item.field || 20;
          processed.sizes = getColumnWidth(item.sizes, field);
        }
        return processed;
      });
      
      // Пересобираем defaultSizesAttr с обработанными значениями
      const sortedSizes = [...processedDefaultSizes].sort((a, b) => (a.max || Infinity) - (b.max || Infinity));
      const fallback = sortedSizes.find(s => !s.max);
      const withMedia = sortedSizes.filter(s => s.max);
      const sizesParts = withMedia.map(s => `(max-width: ${s.max}px) ${s.sizes}`);
      if (fallback) {
        sizesParts.push(fallback.sizes);
      } else {
        sizesParts.push(`${width}px`);
      }
      defaultSizesAttr = sizesParts.join(', ');
    }
  picture&attributes(attributes)
    each source in processedSources
      - const fullBaseName = getFullBaseName(baseName, source.key);
      - const srcset = getSrcset(fullBaseName, folder, source.width, extension);
      
      if (srcset.webpSrcset)
        source(
          type='image/webp'
          media=`(max-width: ${source.max}px)`
          sizes=source.sizes
          srcset=srcset.webpSrcset
        )
        source(
          type=`image/${extension}`
          media=`(max-width: ${source.max}px)`
          srcset=srcset.imgSrcset
        )
    
    - const defaultSrcset = getSrcset(baseName, folder, width, extension);
    if (defaultSrcset.webpSrcset)
      source(
        type='image/webp'
        sizes=defaultSizesAttr
        srcset=defaultSrcset.webpSrcset
      )
    
    img(
      src=`${folder}${baseName}.${extension}`
      alt=alt
      width=width
      height='auto'
      loading=lazy ? 'lazy' : false
      class=imgClass
    )